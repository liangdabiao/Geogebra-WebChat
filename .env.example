# ============================================================
# 模型服务配置（OpenAI 兼容格式）
# ============================================================

# 【必填】模型服务的 API Key（AI 的大脑钥匙）
# 获取方式：你的模型服务平台注册后创建，例如：
#   - tokenhub 平台：注册后在控制台创建 Key
#   - DeepSeek 官方：platform.deepseek.com → API Keys
# 格式形如：sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_API_KEY=

# 模型服务的接口地址（Base URL），常见示例：
#   tokenhub:       https://tokenhub.tencentmaas.com/v1
#   DeepSeek 官方:   https://api.deepseek.com/v1
#   月之暗面:        https://api.moonshot.cn/v1
MODEL_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 默认模型名（访客可在网页右上角随时切换）
# 示例：deepseek/deepseek-flash、deepseek-chat
MODEL_NAME=deepseek/deepseek-flash
