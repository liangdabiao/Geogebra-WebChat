# ============================================================
# 模型配置
#
# 默认走 EdgeOne Makers 内置模型网关：平台统一托管，内置模型开箱即用，
# 不需要对接任何第三方大模型厂商，新账号赠送免费 Token（限时 50 万）。
# ============================================================

# 【必填】EdgeOne Makers 网关 Key
# 获取：Makers 控制台 → Models → API Key → 创建
#   https://console.tencentcloud.com/edgeone/makers?tab=models&subTab=apikey
# 一个 Key 可调用全部内置模型；厂商密钥由平台托管，不会出现在项目里。
MAKERS_MODELS_KEY=

# ---- 以下通常留空，使用内置默认值 ----
# 默认网关（OpenAI 兼容，支持 SSE 流式）：https://ai-gateway.edgeone.link/v1
# 默认模型：@makers/deepseek-v4-flash
# 需要换内置模型时取消注释（内置模型无需绑定厂商密钥）
# MAKERS_MODEL=@makers/deepseek-v4-flash
