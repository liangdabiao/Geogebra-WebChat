# ============================================================
# 模型配置（二选一，两组不要同时填写）
#
# A. 自有厂商 Key（当前默认）：DeepSeek 官方 deepseek-flash 自带视觉输入，
#    可图片读题；按量计费，不受平台免费额度限制。
# B. EdgeOne Makers 内置网关：只填 MAKERS_MODELS_KEY，使用平台免费额度
#    （50 万 token/月，按账号共享，用完需在控制台绑定 BYOK 或提额）。
# ============================================================

# ---- A. 自有厂商配置 ----
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash
MODEL_API_KEY=

# ---- B. EdgeOne Makers 内置网关（启用时请注释/删除上面三行）----
# MAKERS_MODELS_KEY=
# MAKERS_MODEL=@makers/deepseek-v4-flash
